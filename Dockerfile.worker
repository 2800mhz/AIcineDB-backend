# ============================================================================
# Multi-stage Dockerfile for AIcineDB Celery Worker
# FIXED: PyTorch 2.1.2 + Transformers 4.36.2 + Deno for yt-dlp
# ============================================================================

# Stage 1: Base dependencies
FROM python:3.10-slim as base

WORKDIR /app

# Install system dependencies + Deno
RUN apt-get update && apt-get install -y \
    # Build tools
    gcc \
    g++ \
    build-essential \
    cmake \
    pkg-config \
    git \
    # OpenCV dependencies
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    # Audio processing (for Whisper)
    libsndfile1 \
    ffmpeg \
    # Video processing
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    # Additional
    libopenblas-dev \
    liblapack-dev \
    curl \
    unzip \
    wget \
    && rm -rf /var/lib/apt/lists/* \
    # ✅ Install Deno for yt-dlp JavaScript extraction
    && curl -fsSL https://deno.land/install.sh | sh \
    && ln -s /root/.deno/bin/deno /usr/local/bin/deno

# Verify Deno installation
RUN deno --version

# Stage 2: Python dependencies
FROM base as builder

WORKDIR /app

# Copy requirements
COPY requirements.txt . 

# ✅ INSTALL PYTORCH FIRST (CPU version for compatibility)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir \
    torch==2.1.2 \
    torchvision==0.16.2 \
    torchaudio==2.1.2 \
    --index-url https://download.pytorch.org/whl/cpu

# ✅ THEN INSTALL TRANSFORMERS (compatible version)
RUN pip install --no-cache-dir \
    transformers==4.36.2 \
    accelerate==0.25.0 \
    sentence-transformers==2.2.2

# ✅ INSTALL REMAINING DEPENDENCIES
RUN pip install --no-cache-dir -r requirements.txt

# ✅ UPGRADE yt-dlp to latest version
RUN pip install --no-cache-dir --upgrade yt-dlp

# Stage 3: Final runtime
FROM base

WORKDIR /app

# Copy Python packages from builder
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY backend /app/backend

# Create necessary directories
RUN mkdir -p /app/data /app/analyses

# Set environment
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DENO_INSTALL="/root/.deno" \
    PATH="/root/.deno/bin:$PATH"

# ✅ VERIFY PYTORCH/TRANSFORMERS/DENO/YT-DLP ON BUILD
RUN python -c "import torch; print(f'✅ PyTorch: {torch.__version__}')" && \
    python -c "import transformers; print(f'✅ Transformers: {transformers.__version__}')" && \
    python -c "from transformers import CLIPProcessor; print('✅ CLIP OK')" && \
    python -c "import yt_dlp; print(f'✅ yt-dlp: {yt_dlp. version.__version__}')" && \
    deno --version | head -1 | xargs echo "✅ Deno:"

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD celery -A backend.tasks.celery_app inspect ping || exit 1

# Start Celery worker
CMD ["celery", "-A", "backend.tasks.celery_app", "worker", "--loglevel=info", "-E"]