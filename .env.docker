# .env.docker - Docker Environment Configuration Template
# Copy this file to .env when running with Docker Compose
# This file contains Docker-optimized defaults with service hostnames

# ============================================================================
# Database Configuration (Docker Internal Network)
# ============================================================================

# PostgreSQL with pgvector - uses service name 'postgres' as hostname
DATABASE_URL=postgresql://aicine_user:aicine_pass@postgres:5432/aicine
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=aicine_user

# PostgreSQL credentials (used by docker-compose.yml to initialize DB)
POSTGRES_DB=aicine
POSTGRES_USER=aicine_user
POSTGRES_PASSWORD=aicine_pass
POSTGRES_PORT=5432

# ============================================================================
# Redis Configuration (Docker Internal Network)
# ============================================================================

# Redis for Celery task queue - uses service name 'redis' as hostname
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379

# ============================================================================
# Celery Configuration
# ============================================================================

# Celery broker and backend - uses Redis service
CELERY_BROKER_URL=redis://redis:6379
CELERY_RESULT_BACKEND=redis://redis:6379

# Worker settings
CELERY_WORKER_CONCURRENCY=2
CELERY_TASK_TIME_LIMIT=7200
CELERY_TASK_SOFT_TIME_LIMIT=6000

# ============================================================================
# API Keys (REQUIRED - Update with your actual keys)
# ============================================================================

# Google Gemini API Key (for narrative analysis)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (for embeddings and alternative analysis)
OPENAI_API_KEY=

# ============================================================================
# Supabase Configuration (REQUIRED for content storage)
# ============================================================================

# Supabase project URL
SUPABASE_URL=

# Supabase service role key (found in project settings > API)
SUPABASE_SERVICE_KEY=

# ============================================================================
# Application Settings
# ============================================================================

# Environment (development, staging, production)
APP_ENV=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Enable debug mode (disable in production)
DEBUG=true

# Python unbuffered output for better logging in Docker
PYTHONUNBUFFERED=1

# ============================================================================
# File Storage & Processing
# ============================================================================

# Base directory for analysis outputs (container path)
OUTPUT_DIR=/app/analyses

# Video cache directory (container path)
VIDEO_CACHE_DIR=/app/data/videos

# Maximum video size (MB)
MAX_VIDEO_SIZE_MB=500

# ============================================================================
# Video Analysis Settings
# ============================================================================

# Whisper model size (tiny, base, small, medium, large)
# Larger models are more accurate but require more memory/time
WHISPER_MODEL=base

# Frame extraction rate (frames per second)
FRAME_EXTRACTION_FPS=1.0

# Character detection rate (frames per second)
CHARACTER_DETECTION_FPS=2.0

# ============================================================================
# Content Aggregation & Web Scraping
# ============================================================================

# User agent for web scraping
SCRAPING_USER_AGENT=AICineDB Bot/1.0

# Rate limiting for scraping (seconds between requests)
SCRAPING_RATE_LIMIT_DELAY=2

# Maximum retries for failed scraping requests
SCRAPING_MAX_RETRIES=3

# AI-powered content filtering
AI_FILTER_ENABLED=true

# AI relevance thresholds (0-100)
AI_RELEVANCE_THRESHOLD_FESTIVALS=60
AI_RELEVANCE_THRESHOLD_NEWS=70

# Duplicate detection threshold (0.0-1.0, higher = more strict)
DUPLICATE_SIMILARITY_THRESHOLD=0.95

# OpenAI embedding model for similarity search
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ============================================================================
# Service Ports (for docker-compose port mapping)
# ============================================================================

# Flower monitoring dashboard port
FLOWER_PORT=5555

# ============================================================================
# Security (Optional but recommended)
# ============================================================================

# JWT secret for API authentication (generate with: openssl rand -hex 32)
JWT_SECRET=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Flower basic auth (format: username:password)
FLOWER_BASIC_AUTH=

# ============================================================================
# Logging & Monitoring
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable request logging
LOG_REQUESTS=true

# ============================================================================
# Notes for Production Deployment
# ============================================================================
#
# 1. Change all default passwords and secrets
# 2. Use strong, randomly generated credentials
# 3. Set APP_ENV=production
# 4. Set DEBUG=false
# 5. Configure proper CORS_ORIGINS
# 6. Use external managed PostgreSQL and Redis for better reliability
# 7. Set appropriate CELERY_WORKER_CONCURRENCY based on available CPU
# 8. Consider using Docker secrets or external secret management
# 9. Enable SSL/TLS for database connections
# 10. Regularly update Docker images for security patches
#
# ============================================================================
