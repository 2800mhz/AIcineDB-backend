# .env.example - AIcineDB Backend Configuration
# Copy this file to .env and update with your values

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL with pgvector
# For Docker Compose: postgresql://aicine_user:aicine_pass@postgres:5432/aicine
# For local development: postgresql://aicine_user:aicine_pass@localhost:5432/aicine
DATABASE_URL=postgresql://aicine_user:aicine_pass@localhost:5432/aicine

# PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_DB=aicine
POSTGRES_USER=aicine_user
POSTGRES_PASSWORD=aicine_pass
POSTGRES_PORT=5432

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis for Celery task queue
# For Docker Compose: redis://redis:6379
# For local development: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ============================================================================
# API Keys
# ============================================================================

# Google Gemini API Key (for narrative analysis)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, for alternative embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Application Settings
# ============================================================================

# Environment (development, production)
APP_ENV=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Enable debug mode
DEBUG=true

# ============================================================================
# File Storage
# ============================================================================

# Base directory for analysis outputs
OUTPUT_DIR=./analyses

# Video cache directory
VIDEO_CACHE_DIR=./data/videos

# Maximum video size (MB)
MAX_VIDEO_SIZE_MB=500

# ============================================================================
# Analysis Settings
# ============================================================================

# Whisper model size (tiny, base, small, medium, large)
WHISPER_MODEL=base

# Frame extraction FPS
FRAME_EXTRACTION_FPS=1.0

# Character detection FPS
CHARACTER_DETECTION_FPS=2.0

# ============================================================================
# Celery Worker Settings
# ============================================================================

# Worker concurrency
CELERY_WORKER_CONCURRENCY=2

# Task time limits (seconds)
CELERY_TASK_TIME_LIMIT=7200
CELERY_TASK_SOFT_TIME_LIMIT=6000

# ============================================================================
# Security (Optional)
# ============================================================================

# JWT secret for API authentication (if implementing auth)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here

# Admin email addresses
# Single admin
ADMIN_EMAIL=admin@example.com
# Multiple admins (comma-separated)
ADMIN_EMAILS=admin1@example.com,admin2@example.com,admin3@example.com

# CORS allowed origins (comma-separated)
# For development, include localhost origins
# For production, only include your actual domains
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://aicinedb.com,https://www.aicinedb.com

# ============================================================================
# Monitoring (Optional)
# ============================================================================

# Flower (Celery monitoring)
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=user:password

# ============================================================================
# Content Aggregation & Scraping
# ============================================================================

# Scraping Configuration
SCRAPING_USER_AGENT=AICineDB Bot/1.0
SCRAPING_RATE_LIMIT_DELAY=2
SCRAPING_MAX_RETRIES=3

# AI Filtering
AI_FILTER_ENABLED=true
AI_RELEVANCE_THRESHOLD_FESTIVALS=60
AI_RELEVANCE_THRESHOLD_NEWS=70
DUPLICATE_SIMILARITY_THRESHOLD=0.95

# OpenAI for embeddings (required for duplicate detection)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Supabase (required for content storage)
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
