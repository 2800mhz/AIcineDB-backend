# AIcineDB Backend - Environment Configuration
# Copy this file to .env and update the values

# ============================================================================
# DATABASE
# ============================================================================
# PostgreSQL connection URL
DATABASE_URL=postgresql://aicine_user:aicine_pass@localhost:5432/aicine

# ============================================================================
# REDIS
# ============================================================================
# Redis connection URL for Celery task queue
REDIS_URL=redis://localhost:6379

# ============================================================================
# API KEYS
# ============================================================================
# Google Gemini API key for narrative analysis
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (optional, for alternative analysis)
# OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================
# Environment: development, production
ENVIRONMENT=development

# API Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# Enable debug mode
DEBUG=True

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# STORAGE
# ============================================================================
# Directory for downloaded videos
DATA_DIR=./data

# Directory for analysis results
ANALYSES_DIR=./analyses

# Directory for extracted frames
FRAMES_DIR=./frames

# Directory for temporary files
TEMP_DIR=./temp

# ============================================================================
# VIDEO PROCESSING
# ============================================================================
# Maximum video duration in seconds (0 = unlimited)
MAX_VIDEO_DURATION=3600

# Maximum video file size in MB (0 = unlimited)
MAX_VIDEO_SIZE=1000

# Frame extraction rate (frames per second)
FRAME_EXTRACTION_FPS=1

# ============================================================================
# CELERY
# ============================================================================
# Celery worker concurrency
CELERY_WORKER_CONCURRENCY=4

# Celery task time limit in seconds
CELERY_TASK_TIME_LIMIT=7200

# ============================================================================
# CORS
# ============================================================================
# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ============================================================================
# DOCKER
# ============================================================================
# These settings are used when running with Docker Compose
# Override above settings for Docker environment

# Docker PostgreSQL
POSTGRES_DB=aicine
POSTGRES_USER=aicine_user
POSTGRES_PASSWORD=aicine_pass

# Docker Redis
REDIS_HOST=redis
REDIS_PORT=6379
