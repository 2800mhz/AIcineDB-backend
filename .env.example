# .env.example - AIcineDB Backend Configuration
# Copy this file to .env and update with your values

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL with pgvector
# For Docker: postgresql://aicine_user:aicine_pass@localhost:5432/aicine
# For local PostgreSQL: postgresql://postgres:yourpassword@localhost:5432/aicine
DATABASE_URL=postgresql://aicine_user:aicine_pass@localhost:5432/aicine

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis for Celery task queue
# For Docker: redis://localhost:6379
# For local Redis: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379

# ============================================================================
# API Keys
# ============================================================================

# Google Gemini API Key (for narrative analysis)
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional, for alternative embeddings)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Application Settings
# ============================================================================

# Environment (development, production)
APP_ENV=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# Enable debug mode
DEBUG=true

# ============================================================================
# File Storage
# ============================================================================

# Base directory for analysis outputs
OUTPUT_DIR=./analyses

# Video cache directory
VIDEO_CACHE_DIR=./data/videos

# Maximum video size (MB)
MAX_VIDEO_SIZE_MB=500

# ============================================================================
# Analysis Settings
# ============================================================================

# Whisper model size (tiny, base, small, medium, large)
WHISPER_MODEL=base

# Frame extraction FPS
FRAME_EXTRACTION_FPS=1.0

# Character detection FPS
CHARACTER_DETECTION_FPS=2.0

# ============================================================================
# Celery Worker Settings
# ============================================================================

# Worker concurrency
CELERY_WORKER_CONCURRENCY=2

# Task time limits (seconds)
CELERY_TASK_TIME_LIMIT=7200
CELERY_TASK_SOFT_TIME_LIMIT=6000

# ============================================================================
# Security (Optional)
# ============================================================================

# JWT secret for API authentication (if implementing auth)
JWT_SECRET=your_jwt_secret_here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# Monitoring (Optional)
# ============================================================================

# Flower (Celery monitoring)
FLOWER_PORT=5555
FLOWER_BASIC_AUTH=user:password
